# ───────────────────────────────────────────────────────────
# Database
# ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_project_hub?schema=public"

# ───────────────────────────────────────────────────────────
# Redis (BullMQ queues)
# ───────────────────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ───────────────────────────────────────────────────────────
# MinIO (object storage for file versions)
# ───────────────────────────────────────────────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="team-project-hub"
MINIO_USE_SSL=false

# ───────────────────────────────────────────────────────────
# JWT
# ───────────────────────────────────────────────────────────
JWT_SECRET="change-this-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# ───────────────────────────────────────────────────────────
# SMTP (email for invites / notifications)
# ───────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="smtp-password"
SMTP_FROM="Team Project Hub <noreply@example.com>"

# ───────────────────────────────────────────────────────────
# App
# ───────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV="development"
